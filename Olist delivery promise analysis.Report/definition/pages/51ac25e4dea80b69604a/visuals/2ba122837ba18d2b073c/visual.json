              },
              {
                "textRuns": [
                  {
                    "value": "Promise windows increase for slower regions, but do not consistently account for delivery variability.",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "State PA has the widest delivery spread at 18 days, and receives one of the highest promise premiums at 16 days, yet still falls short.",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "AL has a 17-day gap between typical and slow deliveries but receives only a 10-day promise premium, resulting in the highest late rate at 21.4%.",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Note: States with fewer than 300 delivered orders were excluded from the visuals, excluding 850 (0.9%) orders in states below the threshold.",
                    "textStyle": {
                      "fontStyle": "italic",
                      "fontSize": "9pt"
                    }
                  }
                ]
