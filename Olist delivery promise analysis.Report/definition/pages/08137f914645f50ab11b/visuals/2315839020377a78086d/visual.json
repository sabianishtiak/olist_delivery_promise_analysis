  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Customers tolerate slower delivery reasonably well when the promised date is met.",
                    "textStyle": {
                      "fontSize": "14pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Satisfaction drops sharply when delivery promise is missed. This trend is seen even among orders with similar actual delivery times.",
                    "textStyle": {
                      "fontSize": "14pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "The penalty for missing the promise grows with delivery time. Example: 0,86 points on a 6-10 day delivery, and 1,80 points on a 31-60 day delivery.",
                    "textStyle": {
                      "fontSize": "14pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Therefore, expectation management appears to be more important for customer satisfaction than actual delivery time.",
                    "textStyle": {
                      "fontSize": "14pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Note: 8 delivered orders have no review and are excluded from review-score visuals.",
                    "textStyle": {
                      "fontStyle": "italic"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
